#!/usr/bin/env bash
# Sends one HTTP request whose credentials live in a curl config file, and
# retries while the server or GitHub is briefly unable to answer it.
#
# usage: ci-post [-X <method>] <url> <config-file> <response-file> [<body-file>]
#        ci-post -z <url> <config-file> <response-file> <body-file>
#
# <config-file>   curl config lines such as `header = "Authorization: Bearer ..."`,
#                 mode 0600. A bearer on the command line would sit in
#                 /proc/<pid>/cmdline, which every local user can read.
# <response-file> receives the final response body; <response-file>.status
#                 receives its HTTP status code (000 when nothing came back).
# <body-file>     sent as JSON; the method defaults to POST with a body and to
#                 GET without one.
# -z              POSTs <body-file> as application/gzip with X-Ci-Run and
#                 X-Ci-Job taken from CI_RUN_ID and CI_JOB_NAME, and allows
#                 120 s per attempt instead of 60, for a log upload of up to
#                 8 MiB.
#
# Retries: 401 up to 3 times (a run id the server stored a moment ago may not
# be visible yet), 429 and 503 after their Retry-After seconds, 502, 504 and
# transport failures with a growing pause (5, 10, 20, then 30 s; an app server
# restarting refuses connections for a while), all within 300 s in total, and
# a 500 up to 3 times. A 409 after such a failure means an earlier attempt
# landed and only its answer was lost, so it counts as delivered: the server's
# endpoints take each token, result and log once. Exits 0 on a 2xx and 1
# otherwise. Prints nothing on stdout. CI_POST_BACKOFF_SECONDS scales the
# pauses (tests set 0).
set -euo pipefail

usage() {
    echo 'usage: ci-post [-X <method>] <url> <config-file> <response-file> [<body-file>]' >&2
    echo '       ci-post -z <url> <config-file> <response-file> <body-file>' >&2
    exit 2
}

method=''
gzip=false
max_time=60
case "${1:-}" in
    -X)
        method="${2:-}"
        shift 2 || usage
        ;;
    -z)
        gzip=true
        max_time=120
        shift
        ;;
esac

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
    usage
fi

url="$1"
config="$2"
response="$3"
body="${4:-}"
headers="$response.headers"

if [ "$gzip" = true ] && { [ -z "$body" ] || [ -z "${CI_RUN_ID:-}" ] || [ -z "${CI_JOB_NAME:-}" ]; }; then
    usage
fi

curl_args=(
    --config "$config"
    --silent
    --show-error
    --user-agent 'ci-job/1'
    --max-time "$max_time"
    --dump-header "$headers"
    --output "$response"
    --write-out '%{http_code}'
)

if [ "$gzip" = true ]; then
    method=POST
    curl_args+=(
        --header 'Content-Type: application/gzip'
        --header "X-Ci-Run: $CI_RUN_ID"
        --header "X-Ci-Job: $CI_JOB_NAME"
        --data-binary "@$body"
    )
elif [ -n "$body" ]; then
    method="${method:-POST}"
    curl_args+=(
        --header 'Content-Type: application/json'
        --data-binary "@$body"
    )
fi

curl_args+=(
    --request "${method:-GET}"
    --url "$url"
)

max_unauthorized=3
max_server_errors=3
max_gateway_errors=10
wait_budget=300
backoff="${CI_POST_BACKOFF_SECONDS:-5}"

unauthorized=0
server_errors=0
gateway_errors=0
waited=0

# Delta-seconds from the last Retry-After header; an HTTP date or a missing
# header falls back to 5 seconds.
retry_after() {
    local value

    value="$(tr -d '\r' <"$headers" | awk 'tolower($1) == "retry-after:" { v = $2 } END { print v }')"

    if [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt 0 ]; then
        echo "$value"
    else
        echo 5
    fi
}

finish() {
    printf '%s\n' "$1" >"$response.status"
    rm -f "$headers"

    if [[ "$1" =~ ^2[0-9][0-9]$ ]]; then
        exit 0
    fi

    exit 1
}

while :; do
    : >"$headers"

    # curl prints 000 and exits non-zero when no response arrived; that case is
    # retried below like a 5xx, and curl's own message is already on stderr.
    if ! code="$(curl -q "${curl_args[@]}")"; then
        code=000
    fi

    case "$code" in
        2??)
            finish "$code"
            ;;
        401)
            if [ "$unauthorized" -ge "$max_unauthorized" ]; then
                finish "$code"
            fi
            unauthorized=$((unauthorized + 1))
            sleep 2
            ;;
        429 | 503)
            delay="$(retry_after)"
            if [ $((waited + delay)) -gt "$wait_budget" ]; then
                finish "$code"
            fi
            waited=$((waited + delay))
            sleep "$delay"
            ;;
        409)
            # Only after a gateway or transport failure: a first-attempt 409 is a real replay.
            if [ "$gateway_errors" -gt 0 ]; then
                finish 200
            fi
            finish "$code"
            ;;
        000 | 502 | 504)
            delay=$((backoff * (1 << gateway_errors)))
            if [ "$delay" -gt $((backoff * 6)) ]; then
                delay=$((backoff * 6))
            fi
            if [ "$gateway_errors" -ge "$max_gateway_errors" ] || [ $((waited + delay)) -gt "$wait_budget" ]; then
                finish "$code"
            fi
            gateway_errors=$((gateway_errors + 1))
            waited=$((waited + delay))
            sleep "$delay"
            ;;
        5??)
            if [ "$server_errors" -ge "$max_server_errors" ]; then
                finish "$code"
            fi
            server_errors=$((server_errors + 1))
            sleep "$backoff"
            ;;
        *)
            finish "$code"
            ;;
    esac
done
